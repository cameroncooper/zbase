{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zBase",
  "identifier": "com.zbase.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "zBase",
        "width": 1000,
        "height": 880,
        "minWidth": 800,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "label": "main",
        "visible": false,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "app"
    ],
    "icon": [
      "assets/tauri/icon.png",
      "assets/macos/AppIcon.icns",
      "assets/windows/zBase.ico"
    ]
  }
}
